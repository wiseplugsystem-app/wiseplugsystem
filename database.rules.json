{
  "rules": {
    ".read": false,
    ".write": false,
    "device_accounts": {
      ".read": false,
      ".write": false
    },
    "device_owners": {
      ".read": "auth != null && root.child('device_owners/outlet_A').val() === auth.uid && root.child('device_owners/outlet_B').val() === auth.uid",
      "$outlet": {
        ".write": "auth != null && ($outlet === 'outlet_A' || $outlet === 'outlet_B') && (!newData.exists() || newData.val() === auth.uid) && (data.val() === auth.uid || (!data.exists() && root.child('devices/gadget-1/pairing/code').exists() && root.child('pair_requests').child(auth.uid).val() === root.child('devices/gadget-1/pairing/code').val() && root.child('devices/gadget-1/pairing/expiresAt').val() > now))"
      }
    },
    "pair_requests": {
      "$uid": {
        ".read": false,
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (newData.isString() && newData.val().length <= 32))"
      }
    },
    "telemetry_logs": {
      ".read": "auth != null && root.child('device_owners/outlet_A').val() === auth.uid && root.child('device_owners/outlet_B').val() === auth.uid",
      ".write": "auth != null && auth.uid === root.child('device_accounts/gadget-1').val()"
    },
    "appliance_profiles": {
      ".read": "auth != null && root.child('device_owners/outlet_A').val() === auth.uid && root.child('device_owners/outlet_B').val() === auth.uid"
    },
    "appliance_registrations": {
      ".read": "auth != null && root.child('device_owners/outlet_A').val() === auth.uid && root.child('device_owners/outlet_B').val() === auth.uid",
      "$catalog": {
        "$profile": {
          ".write": "auth != null && (($catalog === 'OUTLET_A' && root.child('device_owners/outlet_A').val() === auth.uid) || ($catalog === 'OUTLET_B' && root.child('device_owners/outlet_B').val() === auth.uid)) && (!newData.exists() || root.child('appliance_profiles').child($catalog).child($profile).exists() || root.child('appliance_profiles').child($catalog === 'OUTLET_A' ? 'OUTLET A' : 'OUTLET B').child($profile).exists())",
          ".validate": "newData.hasChildren(['name'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 63" },
          "applianceType": { ".validate": "newData.val() === 'Rice cooker' || newData.val() === 'Flat iron / hair straightener' || newData.val() === 'Electric fan' || newData.val() === 'Other'" },
          "$other": { ".validate": false }
        }
      }
    },
    "alerts": {
      ".read": "auth != null && root.child('device_owners/outlet_A').val() === auth.uid && root.child('device_owners/outlet_B').val() === auth.uid",
      ".write": "auth != null && auth.uid === root.child('device_accounts/gadget-1').val()"
    },
    "commands": {
      ".read": "auth != null && auth.uid === root.child('device_accounts/gadget-1').val()",
      "$outlet": {
        ".read": "auth != null && root.child('device_owners').child($outlet).val() === auth.uid",
        ".write": "auth != null && root.child('device_owners').child($outlet).val() === auth.uid && ($outlet === 'outlet_A' || $outlet === 'outlet_B') && newData.exists() && (root.child('telemetry_logs').child($outlet).child('currentState').val() !== 'LOCKED_OUT' || newData.child('type').val() === 'RESET_SAFETY')",
        ".validate": "newData.hasChildren(['commandID','userID','type','sessionID','revision','expiresAt']) && newData.child('userID').val() === auth.uid && newData.child('sessionID').val() === root.child('telemetry_logs').child($outlet).child('sessionID').val() && newData.child('revision').val() === root.child('telemetry_logs').child($outlet).child('revision').val() && newData.child('expiresAt').isNumber() && newData.child('expiresAt').val() > now && newData.child('expiresAt').val() <= now + 30000 && (newData.child('type').val() === 'TURN_ON' || newData.child('type').val() === 'TURN_OFF' || newData.child('type').val() === 'RESET_SAFETY' || newData.child('type').val() === 'RESTART' || (newData.child('type').val() === 'REMOVE_PROFILE' && newData.child('profileID').isString()) || (newData.child('type').val() === 'MERGE_PROFILE' && newData.child('profileID').isString() && newData.child('sourceID').isString())|| (newData.child('type').val() === 'SMART_OVERRIDE' && newData.child('alertID').val() === root.child('telemetry_logs').child($outlet).child('alertID').val() && root.child('telemetry_logs').child($outlet).child('currentState').val() === 'WARNING' && (!newData.child('extensionDuration').exists() || (newData.child('extensionDuration').isNumber() && newData.child('extensionDuration').val() > 0 && newData.child('extensionDuration').val() <= 3600))) || (newData.child('type').val() === 'EDIT_PROFILE' && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 63 && newData.child('maxRunTime').isNumber() && newData.child('maxRunTime').val() >= 1 && newData.child('safetyCeilingDuration').isNumber() && newData.child('safetyCeilingDuration').val() >= newData.child('maxRunTime').val() && newData.child('safetyCeilingDuration').val() <= 604800))",
        "commandID": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,63}$/)"
        },
        "sessionID": {
          ".validate": "newData.isString() && newData.val().length <= 39"
        },
        "revision": {
          ".validate": "newData.isNumber()"
        },
        "userID": {
          ".validate": "newData.isString()"
        },
        "type": {
          ".validate": "newData.isString()"
        },
        "expiresAt": {
          ".validate": "newData.isNumber()"
        },
        "alertID": {
          ".validate": "newData.isString() && newData.val().length <= 79"
        },
        "profileID": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,63}$/)"
        },
        "sourceID": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,63}$/)"
        },
        "name": {
          ".validate": "newData.isString()"
        },
        "maxRunTime": {
          ".validate": "newData.isNumber()"
        },
        "safetyCeilingDuration": {
          ".validate": "newData.isNumber()"
        },
        "extensionDuration": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "command_results": {
      ".write": "auth != null && auth.uid === root.child('device_accounts/gadget-1').val()",
      "$outlet": {
        ".read": "auth != null && root.child('device_owners').child($outlet).val() === auth.uid"
      }
    },
    "devices": {
      "gadget-1": {
        "pairing": {
          ".read": false,
          ".write": "auth != null && auth.uid === root.child('device_accounts/gadget-1').val()"
        },
        "status": {
          ".read": "auth != null && root.child('device_owners/outlet_A').val() === auth.uid && root.child('device_owners/outlet_B').val() === auth.uid",
          ".write": "auth != null && auth.uid === root.child('device_accounts/gadget-1').val()"
        },
        "outlets": {
          ".read": "(auth != null && root.child('device_owners/outlet_A').val() === auth.uid && root.child('device_owners/outlet_B').val() === auth.uid) || (auth != null && auth.uid === root.child('device_accounts/gadget-1').val())",
          ".write": "auth != null && auth.uid === root.child('device_accounts/gadget-1').val()",
          "$outlet": {
            "isLockedDown": {
              ".write": "auth != null && root.child('device_owners').child($outlet).val() === auth.uid && data.val() === true && newData.val() === false"
            }
          }
        },
        "live_telemetry": {
          ".read": "auth != null && root.child('device_owners/outlet_A').val() === auth.uid && root.child('device_owners/outlet_B').val() === auth.uid",
          ".write": "auth != null && auth.uid === root.child('device_accounts/gadget-1').val()"
        },
        "notifications": {
          ".read": "auth != null && root.child('device_owners/outlet_A').val() === auth.uid && root.child('device_owners/outlet_B').val() === auth.uid",
          ".write": "auth != null && auth.uid === root.child('device_accounts/gadget-1').val()"
        },
        "wifiConfig": {
          ".read": "(auth != null && root.child('device_owners/outlet_A').val() === auth.uid && root.child('device_owners/outlet_B').val() === auth.uid) || (auth != null && auth.uid === root.child('device_accounts/gadget-1').val())",
          ".write": "(auth != null && root.child('device_owners/outlet_A').val() === auth.uid && root.child('device_owners/outlet_B').val() === auth.uid) || (auth != null && auth.uid === root.child('device_accounts/gadget-1').val())",
          ".validate": "newData.hasChildren(['ssid', 'updatedAt', 'updatedBy'])",
          "ssid": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32" },
          "password": { ".validate": "newData.isString() && (newData.val().length === 0 || (newData.val().length >= 8 && newData.val().length <= 63))" },
          "updatedAt": { ".validate": "newData.val() === now" },
          "updatedBy": { ".validate": "newData.val() === auth.uid" },
          "receivedAt": { ".validate": "newData.isNumber() && auth != null && auth.uid === root.child('device_accounts/gadget-1').val()" },
          "ackAt": { ".validate": "newData.isNumber() && auth != null && auth.uid === root.child('device_accounts/gadget-1').val()" },
          "$other": { ".validate": false }
        }
      }
    },
    "users": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !newData.exists()",
        "preferences": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$key": {
            ".validate": "($key === 'deviceAlerts' || $key === 'statusChanges' || $key === 'newDevices' || $key === 'safetyWarnings') && newData.isBoolean()"
          }
        },
        "fcmTokens": {
          ".read": "auth != null && auth.uid === $uid",
          "$token": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "activity_log": {
      ".read": "auth != null && root.child('device_owners/outlet_A').val() === auth.uid && root.child('device_owners/outlet_B').val() === auth.uid",
      ".write": "(auth != null && root.child('device_owners/outlet_A').val() === auth.uid && root.child('device_owners/outlet_B').val() === auth.uid && !newData.exists()) || (auth != null && auth.uid === root.child('device_accounts/gadget-1').val())",
      ".indexOn": ".key"
    },
    "acknowledgments": {
      "$alert": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('device_owners').child(root.child('alerts').child($alert).child('deviceID').val()).val() === auth.uid && root.child('alerts').child($alert).child('resolution').val() === 'SHUTDOWN'",
          ".validate": "newData.val() === true"
        }
      }
    }
  }
}
